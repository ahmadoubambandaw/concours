# --- Base de données ---
DATABASE_URL="postgresql://scolaris:scolaris@localhost:5432/scolaris"

# --- Serveur ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Sécurité JWT (générer des secrets forts en production !) ---
JWT_ACCESS_SECRET=changez-moi-secret-access
JWT_REFRESH_SECRET=changez-moi-secret-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Stockage fichiers ---
STORAGE_DIR=storage

# --- Notifications (optionnel ; sans clés, les envois sont SIMULÉS/journalisés) ---
# Email — SMTP universel (SendGrid, Gmail, Mailgun, Resend, OVH…)
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=xxxxxxxx
# SMTP_FROM="Mon École <no-reply@monecole.sn>"
# SMTP_SECURE=false            # true si port 465

# SMS — Twilio
# TWILIO_ACCOUNT_SID=ACxxxxxxxx
# TWILIO_AUTH_TOKEN=xxxxxxxx
# TWILIO_SMS_FROM=+1xxxxxxxxxx

# WhatsApp — Option 1 : API WhatsApp Business (Meta, recommandé)
# WHATSAPP_TOKEN=EAAxxxxxxxx
# WHATSAPP_PHONE_ID=xxxxxxxxxxxxxxx
# WhatsApp — Option 2 : Twilio WhatsApp (réutilise TWILIO_ACCOUNT_SID/AUTH_TOKEN)
# TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Paiements en ligne PayDunya (Orange Money, Wave, Free Money, carte) ---
# Clés du compte marchand : https://app.paydunya.com → Intégrations → API
# PAYDUNYA_MASTER_KEY=
# PAYDUNYA_PRIVATE_KEY=
# PAYDUNYA_PUBLIC_KEY=
# PAYDUNYA_TOKEN=
# PAYDUNYA_MODE=test          # 'test' (sandbox) ou 'live' (production)
# URLs publiques (redirections et callback IPN)
# PUBLIC_WEB_URL=https://concours-rose.vercel.app
# PUBLIC_API_URL=https://concours-rose.vercel.app

# --- Autres paiements (optionnels) ---
# STRIPE_SECRET_KEY=

# --- Assistant IA (optionnel — les analyses statistiques fonctionnent sans) ---
# AI_API_KEY=

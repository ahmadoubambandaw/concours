# --- Base de données ---
DATABASE_URL="postgresql://scolaris:scolaris@localhost:5432/scolaris"

# --- Serveur ---
PORT=4000
NODE_ENV=development
CORS_ORIGINS=http://localhost:3000

# --- Sécurité JWT (générer des secrets forts en production !) ---
JWT_ACCESS_SECRET=changez-moi-secret-access
JWT_REFRESH_SECRET=changez-moi-secret-refresh
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# --- Stockage fichiers ---
STORAGE_DIR=storage

# --- Fournisseurs de notifications (optionnels ; les canaux sans clé
#     utilisent l'adaptateur console en développement) ---
# SMTP_URL=smtp://user:pass@smtp.example.com:587
# TWILIO_SID=
# TWILIO_TOKEN=
# WA_TOKEN=
# WA_PHONE_ID=
# FCM_SERVER_KEY=

# --- Paiements en ligne (optionnels) ---
# STRIPE_SECRET_KEY=
# ORANGE_MONEY_API_KEY=
# WAVE_API_KEY=

# --- Assistant IA (optionnel — les analyses statistiques fonctionnent sans) ---
# AI_API_KEY=
